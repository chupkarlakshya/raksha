# SafePath Indore Backend Configuration

PORT=8080
ADMIN_USER=admin
ADMIN_PASS=admin
DEMO_MODE=true

# Twilio SMS (Set DEMO_MODE=false to enable)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SOS Configuration
# Fan-out numbers to receive SOS alerts (comma-separated)
SOS_FANOUT_NUMBERS=+919000000001,+919000000002

# Path to the trained Risk Model
RISK_MODEL_PATH=data/risk_model.joblib
