<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#2C2C2C"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header (Question) -->
    <LinearLayout
        android:id="@+id/questionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="24sp"
            tools:ignore="HardcodedText"
            tools:text="⚠️" />

        <TextView
            android:id="@+id/textQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            tools:text="1. What to do if I am being followed?" />

        <ImageView
            android:id="@+id/iconExpand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Expand"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#9AA0A6"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <!-- Body (Answer) -->
    <TextView
        android:id="@+id/textAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:visibility="gone"
        tools:ignore="HardcodedText"
        tools:text="Cross the street and change your direction. Go to a crowded area. Press the SOS button on your phone immediately." />

</LinearLayout>
